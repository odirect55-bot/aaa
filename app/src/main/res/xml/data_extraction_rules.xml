<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup/transfer rules. The sensor baseline is device-specific, so
  the active-session scratch file is never carried across devices; the database
  is, so history survives a phone upgrade.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="walkfit.db" />
        <exclude domain="sharedpref" path="walkfit_active_session.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="walkfit.db" />
        <exclude domain="sharedpref" path="walkfit_active_session.xml" />
    </device-transfer>
</data-extraction-rules>
